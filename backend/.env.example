# Copy this file to .env and adjust values.
# Using SQLite by default so the app is portable and needs zero external DB setup.
# To use Postgres/MySQL instead, change the "provider" in prisma/schema.prisma
# and set DATABASE_URL to the appropriate connection string.

DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-this-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"
PORT=4000
