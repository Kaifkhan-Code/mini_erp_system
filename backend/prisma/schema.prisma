// Prisma schema for Mini Operations ERP
// PostgreSQL/Neon is the default provider for this project.
// Set DATABASE_URL in backend/.env to your Neon connection string.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATIONS
  SALES
}

enum WorkOrderStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum TransferStatus {
  REQUESTED
  DISPATCHED
  RECEIVED
}

enum OrderStatus {
  RESERVED
  CANCELLED
  FULFILLED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         Role
  // Assigned location is used for the "restrict user to assigned location"
  // live-verification scenario. Null = not location-restricted (e.g. Admin).
  location     String?
  createdAt    DateTime @default(now())

  workOrders     WorkOrder[]
  customerOrders CustomerOrder[]
}

model Item {
  id        Int      @id @default(autoincrement())
  name      String
  category  String
  createdAt DateTime @default(now())

  inventory      Inventory[]
  workOrders     WorkOrder[]
  transfers      Transfer[]
  customerOrders CustomerOrder[]
}

// One row per Item + Location + Batch combination.
model Inventory {
  id          Int      @id @default(autoincrement())
  itemId      Int
  item        Item     @relation(fields: [itemId], references: [id])
  location    String
  batch       String
  physicalQty Int      @default(0)
  reservedQty Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Prevents duplicate inventory rows for the same item/location/batch
  // (also blocks the "duplicate inventory transaction" case at DB level).
  @@unique([itemId, location, batch])
}

// Every stock-affecting action is logged here for auditability and to
// support idempotency / duplicate-transaction checks.
model InventoryTransaction {
  id          Int      @id @default(autoincrement())
  inventoryId Int
  type        String // ADJUSTMENT, RESERVE, RELEASE, TRANSFER_OUT, TRANSFER_IN
  quantity    Int
  reference   String? // e.g. "TRANSFER:3" or "ORDER:5", used for idempotency
  createdAt   DateTime @default(now())

  @@unique([reference, type])
}

model WorkOrder {
  id             Int             @id @default(autoincrement())
  location       String
  itemId         Int
  item           Item            @relation(fields: [itemId], references: [id])
  requiredQty    Int
  assignedUserId Int
  assignedUser   User            @relation(fields: [assignedUserId], references: [id])
  status         WorkOrderStatus @default(ASSIGNED)
  createdAt      DateTime        @default(now())
}

model Transfer {
  id             Int            @id @default(autoincrement())
  sourceLocation String
  destLocation   String
  itemId         Int
  item           Item           @relation(fields: [itemId], references: [id])
  quantity       Int
  status         TransferStatus @default(REQUESTED)
  createdAt      DateTime       @default(now())
  dispatchedAt   DateTime?
  receivedAt     DateTime?
}

model CustomerOrder {
  id              Int         @id @default(autoincrement())
  itemId          Int
  item            Item        @relation(fields: [itemId], references: [id])
  location        String
  quantity        Int
  status          OrderStatus @default(RESERVED)
  createdByUserId Int
  createdBy       User        @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime    @default(now())
}
